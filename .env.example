# Copy this file to `.env` and fill in the real values:
#
#     cp .env.example .env
#
# `.env` is listed in .gitignore, so real secrets stay on this machine and never reach
# the repository. `.env.example` is committed on purpose and must contain **no real
# values** -- placeholders only.
#
# `config/settings.py` reads this file at startup. A variable that is already exported
# in your shell wins over the file, so `DJANGO_DEBUG=False python manage.py check`
# works without editing anything.

# --- Django ---------------------------------------------------------------------

# Required. Django refuses to start without it. Generate a fresh one with:
#     python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string

# "True" during development, "False" in production. Compared case-insensitively.
DJANGO_DEBUG=True

# Comma separated hostnames and IP addresses, e.g. "example.com,www.example.com".
# Empty means localhost only, which is right for development.
#
# To let other people reach the project on your own network, this must list the address
# they will type -- otherwise every request answers 400 Bad Request:
#
#     DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.42
DJANGO_ALLOWED_HOSTS=

# Serve the generated audio (media/) through Django itself. Leave empty in production,
# where the web server does it. Turn it on for the one case with no web server and DEBUG
# off -- running the project on a laptop for other people to try:
#
#     DJANGO_DEBUG=False DJANGO_SERVE_MEDIA=True \
#       python manage.py runserver 0.0.0.0:8000 --insecure
#
# `--insecure` is what makes Django serve /static/ once DEBUG is off, and
# DJANGO_SERVE_MEDIA is what makes it serve /media/. Both are needed: without them the
# pages render with no styling and no audio. See the comment in config/urls.py.
#
# One hosting case needs it too, for a different reason. A web server that ignores the
# Range header can play an audio clip but never be seeked inside it -- and this project's
# grammar and lesson clips run 13-40 seconds. PythonAnywhere's static file server is one
# of those (measured: a request for `Range: bytes=100-199` came back `200` with all 11,232
# bytes and no `Accept-Ranges`). There, set this to True *and* leave out the /media/ static
# file mapping, so those requests reach Django's own view (config/media.py) which answers
# `206` with a `Content-Range`. Measured on the live deployment: `bytes=100-199` → `206`,
# 100 bytes, `Content-Range: bytes 100-199/11232`. Stylesheets and scripts stay on the
# host's server either way, which is where the traffic is; audio is only fetched when a
# learner presses play (`preload="none"`).
DJANGO_SERVE_MEDIA=

# Origins allowed to POST to this site, comma separated, each as scheme://host with no
# trailing slash. Set this when something terminates HTTPS in front of Django without
# forwarding the original scheme -- a reverse proxy, or a tunnel such as Cloudflare's.
#
# Skip it and you get a confusing half-broken site: **every page loads and every form
# answers 403**, because the browser sends `Origin: https://…` while Django, seeing plain
# HTTP on the inside, compares it against `http://…`. See config/settings.py.
#
# The site's hostname also belongs in DJANGO_ALLOWED_HOSTS, otherwise every request answers
# 400 Bad Request while static files still load -- which is what makes it look half-broken.
#
#     DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1,velingo.example"
#     DJANGO_CSRF_TRUSTED_ORIGINS="https://velingo.example"
DJANGO_CSRF_TRUSTED_ORIGINS=

# "True" when a proxy terminates HTTPS in front of Django -- PythonAnywhere does, and so
# does the Cloudflare tunnel in run_with_domain.sh. Django then trusts the
# X-Forwarded-Proto header that proxy sets, so `request.is_secure()` is True and the CSRF
# check's Referer fallback compares https:// against https:// instead of http://.
#
# Leave it empty on a laptop: with no proxy in front, a client could send that header
# itself and claim a secure request that was not.
DJANGO_BEHIND_HTTPS_PROXY=

# --- Database --------------------------------------------------------------------

# "postgresql" (the default, and what every development machine here uses) or "sqlite".
#
# A host that gives you a database file instead of a database server sets sqlite --
# PythonAnywhere's free plan is one. With sqlite there is no server, no user and no
# password: the database *is* a file, and DB_NAME is its name rather than a database name.
#
#     DB_ENGINE=sqlite
#     DB_NAME=db.sqlite3
#
# Both engines are read through the same models, so the site behaves the same either way.
DB_ENGINE=postgresql

# The rest of this section is only read when DB_ENGINE is postgresql.
DB_NAME=language_learning
DB_USER=django_user
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

# The mirror copy of the project (config/settings_mirror.py) reuses every value above
# and only swaps the database name for `language_learning_mirror`, so it needs no keys
# of its own.
